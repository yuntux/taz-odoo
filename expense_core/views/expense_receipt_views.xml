<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <!-- Écran de saisie simplifié d'un reçu de dépense, pensé pour le téléphone : la photo se joint dans le chatter,
         puis « Lire le justificatif » préremplit la date et les lignes, le salarié choisit son projet et les taxes. -->
    <record id="view_expense_receipt_form" model="ir.ui.view">
        <field name="name">account.move.form.expense.receipt</field>
        <field name="model">account.move</field>
        <field name="priority">99</field>
        <field name="arch" type="xml">
            <form string="Reçu de dépense">
                <header>
                    <button name="action_run_ocr" string="Lire le justificatif" type="object"
                            class="oe_highlight" invisible="state != 'draft'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,posted"/>
                </header>
                <sheet>
                    <div class="alert alert-warning mb-0" role="alert" invisible="not expense_warning or state != 'draft'">
                        <field name="expense_warning" readonly="1" nolabel="1"/>
                    </div>
                    <group>
                        <field name="move_type" invisible="1"/>
                        <field name="expense_origin" invisible="1"/>
                        <field name="company_id" invisible="1"/>
                        <field name="currency_id" invisible="1"/>
                        <field name="journal_id" invisible="1"/>
                        <field name="allowed_project_ids" invisible="1"/>
                        <field name="partner_id" readonly="1" string="Salarié remboursé"/>
                        <field name="invoice_date" string="Date de la dépense" readonly="state != 'draft'"/>
                        <field name="expense_category_id" readonly="state != 'draft'" options="{'no_create': True}"/>
                        <field name="expense_show_lines" invisible="1"/>
                        <field name="expense_project_id" readonly="state != 'draft'"
                               domain="[('id', 'in', allowed_project_ids)]" options="{'no_create': True}"/>
                        <field name="expense_merchant_id" readonly="state != 'draft'" options="{'no_create': True}"/>
                    </group>
                    <field name="invoice_line_ids" readonly="state != 'draft'" nolabel="1"
                           invisible="not expense_show_lines"
                           context="{'default_move_type': move_type, 'journal_id': journal_id,
                                     'default_partner_id': partner_id, 'default_currency_id': currency_id,
                                     'default_product_id': expense_category_id}">
                        <list editable="bottom">
                            <field name="sequence" widget="handle"/>
                            <field name="display_type" column_invisible="True"/>
                            <field name="product_id" string="Catégorie" optional="hide"/>
                            <field name="name" string="Description"/>
                            <field name="quantity" column_invisible="True"/>
                            <field name="price_unit" string="Montant TTC"/>
                            <field name="tax_ids" widget="many2many_tags" options="{'no_create': True}"
                                   string="Taux de TVA"/>
                            <field name="account_id" column_invisible="True"/>
                            <field name="company_id" column_invisible="True"/>
                            <field name="currency_id" column_invisible="True"/>
                        </list>
                    </field>
                    <group class="oe_subtotal_footer">
                        <field name="amount_tax" string="dont TVA"/>
                        <field name="amount_total" string="Total TTC"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_expense_my_receipts" model="ir.actions.act_window">
        <field name="name">Mes notes de frais</field>
        <field name="res_model">account.move</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('move_type', '=', 'in_invoice'), ('expense_origin', '=', 'employee_receipt'), ('partner_id.employee_ids.user_id', '=', uid)]</field>
        <field name="context">{'default_move_type': 'in_invoice', 'default_expense_origin': 'employee_receipt'}</field>
    </record>
    <record id="action_expense_my_receipts_list" model="ir.actions.act_window.view">
        <field name="sequence" eval="1"/>
        <field name="view_mode">list</field>
        <field name="view_id" ref="account.view_in_invoice_tree"/>
        <field name="act_window_id" ref="action_expense_my_receipts"/>
    </record>
    <record id="action_expense_my_receipts_form" model="ir.actions.act_window.view">
        <field name="sequence" eval="2"/>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_expense_receipt_form"/>
        <field name="act_window_id" ref="action_expense_my_receipts"/>
    </record>

    <menuitem id="menu_expense_root" name="Notes de frais" sequence="45"
              groups="taz-common.taz-basic" web_icon="account,static/description/icon.png"/>
    <menuitem id="menu_expense_my_receipts" name="Mes notes de frais" sequence="1"
              parent="menu_expense_root" action="action_expense_my_receipts"/>

</odoo>
