<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <!-- Écran de saisie simplifié d'un reçu de dépense, pensé pour le téléphone : la photo vient de l'écran
         « Photographier un ticket », « Lire le justificatif » préremplit la date et les lignes, le salarié choisit son
         projet, écrit son commentaire et envoie la dépense en validation. Ni lignes ni chatter sur cet écran. -->
    <record id="view_expense_receipt_form" model="ir.ui.view">
        <field name="name">account.move.form.expense.receipt</field>
        <field name="model">account.move</field>
        <field name="priority">99</field>
        <field name="arch" type="xml">
            <!-- create="0" : un reçu se crée par l'écran « Photographier un ticket », pas par un formulaire vide. -->
            <form string="Reçu de dépense" create="0">
                <sheet>
                    <field name="state" invisible="1"/>
                    <field name="validation_status" invisible="1"/>
                    <field name="need_validation" invisible="1"/>
                    <field name="hide_reviews" invisible="1"/>
                    <div class="alert alert-warning mb-0" role="alert" invisible="not expense_warning or state != 'draft'">
                        <field name="expense_warning" readonly="1" nolabel="1"/>
                    </div>
                    <div class="alert alert-info mb-0" role="alert"
                         invisible="validation_status not in ['waiting', 'pending']">
                        En attente de validation : <field name="next_review" readonly="1" nolabel="1" class="d-inline"/>
                    </div>
                    <div class="alert alert-success mb-0" role="alert" invisible="validation_status != 'validated'">
                        Dépense validée.
                    </div>
                    <div class="alert alert-danger mb-0" role="alert" invisible="validation_status != 'rejected'">
                        Dépense refusée : voir le motif ci-dessous, corrigez puis renvoyez-la.
                    </div>
                    <div class="mb-2" invisible="state != 'draft' or validation_status != 'no'">
                        <button name="action_run_ocr" string="Lire le justificatif" type="object" class="btn btn-secondary"/>
                    </div>
                    <group>
                        <field name="move_type" invisible="1"/>
                        <field name="expense_origin" invisible="1"/>
                        <field name="company_id" invisible="1"/>
                        <field name="currency_id" invisible="1"/>
                        <field name="journal_id" invisible="1"/>
                        <field name="allowed_project_ids" invisible="1"/>
                        <field name="partner_id" readonly="1" string="Salarié remboursé"
                               groups="taz-common.taz-adv"/>
                        <field name="invoice_date" string="Date de la dépense" readonly="state != 'draft'"/>
                        <field name="expense_category_id" readonly="state != 'draft'" options="{'no_create': True}"/>
                        <field name="expense_show_lines" invisible="1"/>
                        <field name="expense_project_id" readonly="state != 'draft'"
                               domain="[('id', 'in', allowed_project_ids)]" options="{'no_create': True}"/>
                        <field name="expense_merchant_id" readonly="state != 'draft'" options="{'no_create': True}"/>
                        <field name="comment" string="Description" required="1" readonly="state != 'draft'"
                               placeholder="Motif de la dépense (client, participants, objet)"/>
                    </group>
                    <field name="invoice_line_ids" readonly="state != 'draft'" nolabel="1"
                           invisible="1"
                           context="{'default_move_type': move_type, 'journal_id': journal_id,
                                     'default_partner_id': partner_id, 'default_currency_id': currency_id,
                                     'default_product_id': expense_category_id}">
                        <list editable="bottom">
                            <field name="sequence" widget="handle"/>
                            <field name="display_type" column_invisible="True"/>
                            <field name="product_id" string="Catégorie" optional="hide"/>
                            <field name="name" string="Description"/>
                            <field name="quantity" column_invisible="True"/>
                            <field name="price_unit" string="Montant TTC"/>
                            <field name="tax_ids" widget="many2many_tags" options="{'no_create': True}"
                                   string="Taux de TVA"/>
                            <field name="account_id" column_invisible="True"/>
                            <field name="company_id" column_invisible="True"/>
                            <field name="currency_id" column_invisible="True"/>
                        </list>
                    </field>
                    <!-- Le montant TTC du ticket : c'est ce que le salarié se fait rembourser. -->
                    <group>
                        <field name="amount_total" string="Montant à rembourser"/>
                    </group>
                    <!-- Sans chatter, le salarié lit ici la réponse des valideurs (le motif d'un refus). -->
                    <field name="review_ids" widget="tier_validation" invisible="not review_ids" readonly="1">
                        <list>
                            <field name="name"/>
                            <field name="display_status"/>
                            <field name="todo_by"/>
                            <field name="done_by"/>
                            <field name="reviewed_formated_date"/>
                            <field name="comment"/>
                        </list>
                    </field>
                    <!-- Le demandeur envoie sa dépense en validation (bon à payer : Office, puis directeur de mission).
                         Les niveaux sont ceux de data/tier_definition_data.xml, livrés inactifs : tant qu'ils ne sont pas
                         activés, need_validation est faux et ce bouton n'apparaît pas. -->
                    <div class="mt-3">
                        <button name="request_validation" string="Envoyer en validation" type="object"
                                class="btn btn-primary btn-lg w-100"
                                invisible="not need_validation or validation_status == 'rejected' or hide_reviews"/>
                        <button name="restart_validation" string="Corriger et renvoyer" type="object"
                                class="btn btn-primary btn-lg w-100"
                                invisible="validation_status != 'rejected' or hide_reviews"/>
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Liste de « Mes notes de frais », sans bouton « Nouveau » (create="0") : la création passe par la photo. -->
    <record id="view_expense_receipt_list" model="ir.ui.view">
        <field name="name">account.move.list.expense.receipt</field>
        <field name="model">account.move</field>
        <field name="priority">99</field>
        <field name="arch" type="xml">
            <list string="Mes notes de frais" create="0" decoration-muted="state == 'cancel'">
                <field name="invoice_date" string="Date"/>
                <field name="expense_merchant_id"/>
                <field name="comment" string="Description"/>
                <field name="amount_total" string="Total TTC" sum="Total"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="validation_status" widget="badge" optional="show"/>
                <field name="state" widget="badge" optional="show"/>
            </list>
        </field>
    </record>

    <record id="action_expense_my_receipts" model="ir.actions.act_window">
        <field name="name">Mes notes de frais</field>
        <field name="res_model">account.move</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('move_type', '=', 'in_invoice'), ('expense_origin', '=', 'employee_receipt'), ('partner_id.employee_ids.user_id', '=', uid)]</field>
        <field name="context">{'default_move_type': 'in_invoice', 'default_expense_origin': 'employee_receipt'}</field>
    </record>
    <record id="action_expense_my_receipts_list" model="ir.actions.act_window.view">
        <field name="sequence" eval="1"/>
        <field name="view_mode">list</field>
        <field name="view_id" ref="view_expense_receipt_list"/>
        <field name="act_window_id" ref="action_expense_my_receipts"/>
    </record>
    <record id="action_expense_my_receipts_form" model="ir.actions.act_window.view">
        <field name="sequence" eval="2"/>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_expense_receipt_form"/>
        <field name="act_window_id" ref="action_expense_my_receipts"/>
    </record>

    <menuitem id="menu_expense_root" name="Notes de frais" sequence="45"
              groups="taz-common.taz-basic" web_icon="account,static/description/icon.png"/>
    <record id="action_expense_capture" model="ir.actions.client">
        <field name="name">Photographier un ticket</field>
        <field name="tag">expense_core.receipt_capture</field>
    </record>
    <menuitem id="menu_expense_capture" name="Photographier un ticket" sequence="0"
              parent="menu_expense_root" action="action_expense_capture"/>
    <menuitem id="menu_expense_my_receipts" name="Mes notes de frais" sequence="1"
              parent="menu_expense_root" action="action_expense_my_receipts"/>

</odoo>
