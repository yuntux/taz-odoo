<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <record id="res_config_settings_view_form_expense_payment" model="ir.ui.view">
        <field name="name">res.config.settings.form.expense.payment</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="account.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@id='print_vendor_checks_setting_container']" position="inside">
                <setting id="expense_payment_method_line" string="Mode de paiement des dépenses"
                         help="Appliqué aux factures et reçus fournisseurs dont le fournisseur n'a pas de mode de paiement préféré.">
                    <field name="expense_payment_method_line_id"/>
                </setting>
                <setting id="expense_reimbursement_method_line" string="Mode de paiement des remboursements"
                         help="Appliqué aux reçus de salariés à rembourser par la tâche hebdomadaire.">
                    <field name="expense_reimbursement_method_line_id"/>
                </setting>
            </xpath>
            <xpath expr="//block[@id='print_vendor_checks_setting_container']" position="after">
                <block title="Lecture des justificatifs (OCR)" id="expense_ocr_block" groups="base.group_system">
                    <setting id="expense_ocr" string="Service de lecture des tickets et factures"
                             help="Renseigner l'adresse et la clé de la ressource Azure Document Intelligence. La clé n'est lisible que des administrateurs.">
                        <field name="expense_ocr_provider"/>
                        <div class="content-group" invisible="not expense_ocr_provider">
                            <div class="row mt8"><label for="expense_ocr_endpoint" class="col-lg-4"/><field name="expense_ocr_endpoint"/></div>
                            <div class="row"><label for="expense_ocr_api_key" class="col-lg-4"/><field name="expense_ocr_api_key" password="True"/></div>
                            <div class="row"><label for="expense_ocr_model" class="col-lg-4"/><field name="expense_ocr_model"/></div>
                            <div class="row"><label for="expense_ocr_invoice_model" class="col-lg-4"/><field name="expense_ocr_invoice_model"/></div>
                        </div>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>

</odoo>
