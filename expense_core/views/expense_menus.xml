<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <!-- File de travail du bon à payer : l'Office et les DM y retrouvent leurs pièces à valider. -->
    <record id="action_expense_to_validate" model="ir.actions.act_window">
        <field name="name">Dépenses à valider</field>
        <field name="res_model">account.move</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('move_type', 'in', ['in_invoice'])]</field>
        <field name="context">{'default_move_type': 'in_invoice', 'search_default_expense_to_validate_me': 1}</field>
        <field name="search_view_id" ref="account.view_account_invoice_filter"/>
    </record>
    <record id="action_expense_to_validate_list" model="ir.actions.act_window.view">
        <field name="sequence" eval="1"/>
        <field name="view_mode">list</field>
        <field name="view_id" ref="account.view_in_invoice_tree"/>
        <field name="act_window_id" ref="action_expense_to_validate"/>
    </record>
    <record id="action_expense_to_validate_form" model="ir.actions.act_window.view">
        <field name="sequence" eval="2"/>
        <field name="view_mode">form</field>
        <field name="view_id" ref="account.view_move_form"/>
        <field name="act_window_id" ref="action_expense_to_validate"/>
    </record>

    <menuitem id="menu_expense_to_validate" name="Dépenses à valider" sequence="1"
              parent="account.menu_finance_payables" action="action_expense_to_validate"
              groups="base.group_user"/>

</odoo>
