<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <!-- Un salarié (TAZ-Basic) crée et modifie ses propres dépenses (factures fournisseur d'origine « reçu salarié ») en brouillon, et seulement eux.
         Ces règles ne donnent que l'écriture : la lecture dépend des droits comptables existants (rubrique 17.7).
         Les lignes peuvent aussi être supprimées, car Odoo recrée les lignes de taxe à chaque modification. -->
    <record id="rule_expense_receipt_own" model="ir.rule">
        <field name="name">Reçus de dépenses : les siens, en brouillon</field>
        <field name="model_id" ref="account.model_account_move"/>
        <field name="groups" eval="[(4, ref('taz-common.taz-basic'))]"/>
        <field name="domain_force">[('move_type', '=', 'in_invoice'), ('expense_origin', '=', 'employee_receipt'), ('state', '=', 'draft'), ('partner_id.employee_ids.user_id', '=', user.id)]</field>
        <field name="perm_read" eval="False"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="rule_expense_receipt_line_own" model="ir.rule">
        <field name="name">Lignes de reçus de dépenses : les siennes, en brouillon</field>
        <field name="model_id" ref="account.model_account_move_line"/>
        <field name="groups" eval="[(4, ref('taz-common.taz-basic'))]"/>
        <field name="domain_force">[('move_id.move_type', '=', 'in_invoice'), ('move_id.expense_origin', '=', 'employee_receipt'), ('move_id.state', '=', 'draft'), ('move_id.partner_id.employee_ids.user_id', '=', user.id)]</field>
        <field name="perm_read" eval="False"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>

</odoo>
