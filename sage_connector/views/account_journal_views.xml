<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <record id="view_account_journal_form_sage_connector" model="ir.ui.view">
        <field name="name">account.journal.form.sage.connector</field>
        <field name="model">account.journal</field>
        <field name="inherit_id" ref="account.view_account_journal_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page name="sage_connector" string="Sage FRP 1000">
                    <group>
                        <field name="sage_sync_date_start"/>
                        <field name="sage_sync_date_end"/>
                        <field name="sage_journal_code"/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

</odoo>
