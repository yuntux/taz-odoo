<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <record id="view_move_form_sage_connector" model="ir.ui.view">
        <field name="name">account.move.form.sage.connector</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='accounting_info_group']" position="inside">
                <field name="sage_sync_status" readonly="1"/>
            </xpath>
        </field>
    </record>

</odoo>
