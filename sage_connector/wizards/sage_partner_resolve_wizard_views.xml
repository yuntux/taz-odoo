<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <record id="view_sage_partner_resolve_batch_wizard_form" model="ir.ui.view">
        <field name="name">sage.partner.resolve.batch.wizard.form</field>
        <field name="model">sage.partner.resolve.batch.wizard</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <field name="line_ids">
                        <list editable="bottom" decoration-muted="resolved">
                            <field name="partner_id" readonly="1"/>
                            <field name="role" readonly="1"/>
                            <field name="resolved" column_invisible="1"/>
                            <field name="is_create_option" column_invisible="1"/>
                            <field name="code" readonly="1" string="Code Sage"/>
                            <field name="name" readonly="1" string="Libellé"/>
                            <field name="new_code" readonly="not is_create_option" string="Code à créer"/>
                            <field name="selected" readonly="resolved" string="Choisir"/>
                        </list>
                    </field>
                </sheet>
                <footer>
                    <button name="action_validate" type="object" string="Valider" class="btn-primary"/>
                    <button string="Annuler" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
