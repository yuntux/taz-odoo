<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="hr_skill_view_form_inherit_staffing" model="ir.ui.view">
        <field name="name">hr.skill.form.inherit.staffing</field>
        <field name="model">hr.skill</field>
        <field name="inherit_id" ref="hr_skills.hr_skill_view_form"/>
        <field name="arch" type="xml">
            <field name="skill_type_id" position="after">
                <field name="is_certification"/>
                <field name="validity_duration_in_months" invisible="not is_certification"/>
                <field name="description"/>
            </field>
        </field>
    </record>

    <record id="employee_skill_view_tree_inherit_staffing" model="ir.ui.view">
        <field name="name">hr.skill.list.inherit.staffing</field>
        <field name="model">hr.skill</field>
        <field name="inherit_id" ref="hr_skills.employee_skill_view_tree"/>
        <field name="arch" type="xml">
            <field name="skill_type_id" position="after">
                <field name="is_certification" optional="show"/>
            </field>
        </field>
    </record>

    <record id="employee_skill_level_view_form_inherit_staffing" model="ir.ui.view">
        <field name="name">hr.skill.level.form.inherit.staffing</field>
        <field name="model">hr.skill.level</field>
        <field name="inherit_id" ref="hr_skills.employee_skill_level_view_form"/>
        <field name="arch" type="xml">
            <field name="level_progress" position="after">
                <field name="description"/>
            </field>
        </field>
    </record>

    <record id="employee_skill_level_view_tree_inherit_staffing" model="ir.ui.view">
        <field name="name">hr.skill.level.list.inherit.staffing</field>
        <field name="model">hr.skill.level</field>
        <field name="inherit_id" ref="hr_skills.employee_skill_level_view_tree"/>
        <field name="arch" type="xml">
            <field name="default_level" position="after">
                <field name="description" optional="hide"/>
            </field>
        </field>
    </record>

    <record id="employee_skill_view_form_inherit_staffing" model="ir.ui.view">
        <field name="name">hr.employee.skill.form.inherit.staffing</field>
        <field name="model">hr.employee.skill</field>
        <field name="inherit_id" ref="hr_skills.employee_skill_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet/group" position="after">
                <group invisible="not skill_is_certification">
                    <field name="skill_is_certification" invisible="1"/>
                    <field name="obtained_date"/>
                    <field name="expiry_date" readonly="1"/>
                </group>
            </xpath>
        </field>
    </record>

    <record id="hr_employee_view_form_inherit_staffing_skills" model="ir.ui.view">
        <field name="name">hr.employee.view.form.inherit.staffing.skills</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr_skills.hr_employee_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='employee_skill_ids']//field[@name='level_progress']" position="after">
                <field name="obtained_date" optional="hide"/>
                <field name="expiry_date" optional="hide"/>
            </xpath>
        </field>
    </record>

    <record id="hr_employee_public_view_form_inherit_staffing_skills" model="ir.ui.view">
        <field name="name">hr.employee.public.view.form.inherit.staffing.skills</field>
        <field name="model">hr.employee.public</field>
        <field name="inherit_id" ref="hr_skills.hr_employee_public_view_form_inherit"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='employee_skill_ids']//field[@name='level_progress']" position="after">
                <field name="obtained_date" optional="hide"/>
                <field name="expiry_date" optional="hide"/>
            </xpath>
        </field>
    </record>

    <record id="res_users_view_form_inherit_staffing_skills" model="ir.ui.view">
        <field name="name">hr.user.preferences.form.inherit.staffing.skills</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="hr_skills.res_users_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='employee_skill_ids']//field[@name='level_progress']" position="after">
                <field name="obtained_date" optional="hide"/>
                <field name="expiry_date" optional="hide"/>
            </xpath>
        </field>
    </record>

</odoo>
