<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="res_config_settings_view_form_expense_qonto" model="ir.ui.view">
        <field name="name">res.config.settings.form.expense.qonto</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="account.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@id='expense_ocr_block']" position="after">
                <block title="Cartes Qonto" id="expense_qonto_block" groups="base.group_system">
                    <setting id="expense_qonto" string="API et webhook Qonto"
                             help="Environnement, mode de connexion (OAuth 2.0 ou clé d'API) et webhook. Les identifiants ne sont lisibles que des administrateurs.">
                        <div class="content-group">
                            <div class="row mt8"><label for="qonto_environment" class="col-lg-4"/><field name="qonto_environment" widget="radio"/></div>
                            <div class="row" invisible="qonto_environment != 'sandbox'">
                                <label for="qonto_staging_token" class="col-lg-4"/>
                                <field name="qonto_staging_token" password="True" required="qonto_environment == 'sandbox'"/>
                            </div>
                            <div class="row"><label for="qonto_auth_mode" class="col-lg-4"/><field name="qonto_auth_mode" widget="radio"/></div>

                            <!-- Connexion par clé d'API : lecture des transactions seulement (pas de webhook). -->
                            <div class="row" invisible="qonto_auth_mode != 'api_key'"><label for="statement_import_api_login" class="col-lg-4"/><field name="statement_import_api_login"/></div>
                            <div class="row" invisible="qonto_auth_mode != 'api_key'"><label for="statement_import_api_password" class="col-lg-4"/><field name="statement_import_api_password" password="True"/></div>

                            <!-- Connexion OAuth 2.0 : application du portail développeur de Qonto. -->
                            <div class="row" invisible="qonto_auth_mode != 'oauth'"><label for="qonto_oauth_client_id" class="col-lg-4"/><field name="qonto_oauth_client_id"/></div>
                            <div class="row" invisible="qonto_auth_mode != 'oauth'"><label for="qonto_oauth_client_secret" class="col-lg-4"/><field name="qonto_oauth_client_secret" password="True"/></div>
                            <div class="row" invisible="qonto_auth_mode != 'oauth'"><label for="qonto_oauth_scope_ids" class="col-lg-4"/><field name="qonto_oauth_scope_ids" widget="many2many_tags" options="{'no_create': True}"/></div>
                            <!-- Adresse enregistrée et collage de l'adresse de retour : seulement en bac à sable, où l'application
                                 de test peut avoir une adresse de redirection qui n'est pas celle de ce serveur. -->
                            <div class="row" invisible="qonto_auth_mode != 'oauth' or qonto_environment != 'sandbox'"><label for="qonto_oauth_redirect_custom" class="col-lg-4"/><field name="qonto_oauth_redirect_custom" placeholder="Laisser vide pour l'adresse proposée ci-dessous"/></div>
                            <div class="row" invisible="qonto_auth_mode != 'oauth'"><label for="qonto_oauth_redirect_uri" class="col-lg-4"/><field name="qonto_oauth_redirect_uri" readonly="1"/></div>
                            <div class="row mt8" invisible="qonto_auth_mode != 'oauth'">
                                <div class="col-lg-4"/>
                                <div class="col">
                                    <button name="action_qonto_oauth_connect" type="object" class="btn-primary"
                                            string="Se connecter à Qonto"
                                            confirm="Ouvrir la page d'autorisation de Qonto ? Les réglages saisis ci-dessus sont enregistrés d'abord."/>
                                    <button name="action_qonto_oauth_disconnect" type="object" string="Se déconnecter"
                                            invisible="not qonto_oauth_connected_on"
                                            confirm="Oublier les jetons de Qonto ? Il faudra se reconnecter."/>
                                </div>
                            </div>
                            <!-- Si Qonto ramène le navigateur ailleurs que sur ce serveur : coller ici l'adresse de retour. -->
                            <div class="row" invisible="qonto_auth_mode != 'oauth' or qonto_environment != 'sandbox' or qonto_oauth_connected_on">
                                <label for="qonto_oauth_return_url" class="col-lg-4"/>
                                <field name="qonto_oauth_return_url" placeholder="https://…?code=…&amp;state=… (ou le code seul)"/>
                                <button name="action_qonto_oauth_finish_pasted" type="object" string="Finaliser la connexion"
                                        invisible="not qonto_oauth_return_url"/>
                            </div>
                            <div class="row" invisible="qonto_auth_mode != 'oauth' or not qonto_oauth_connected_on">
                                <label for="qonto_oauth_connected_on" class="col-lg-4"/><field name="qonto_oauth_connected_on"/>
                            </div>

                            <div class="row mt8"><label for="qonto_default_partner_id" class="col-lg-4"/><field name="qonto_default_partner_id"/></div>

                            <!-- Webhook : n'existe qu'en OAuth 2.0 (la clé d'API de Qonto n'y donne pas accès). -->
                            <div class="row mt8" invisible="qonto_auth_mode != 'oauth' or qonto_webhook_subscription_id">
                                <div class="col-lg-4"/>
                                <div class="col"><button name="action_qonto_register_webhook" type="object" class="btn-primary"
                                        string="Inscrire le webhook" confirm="Inscrire chez Qonto l'adresse de ce serveur pour recevoir les transactions par carte ?"/></div>
                            </div>
                            <div class="row mt8" invisible="not qonto_webhook_subscription_id">
                                <label for="qonto_webhook_subscription_id" class="col-lg-4"/><field name="qonto_webhook_subscription_id"/>
                                <button name="action_qonto_unregister_webhook" type="object" string="Supprimer le webhook"
                                        confirm="Supprimer l'abonnement chez Qonto ? Les transactions ne seront plus reçues que par la lecture planifiée."/>
                            </div>
                            <div class="row mt8" invisible="not qonto_webhook_secret">
                                <label for="qonto_webhook_secret" class="col-lg-4"/><field name="qonto_webhook_secret" password="True" readonly="1"/>
                            </div>
                            <div class="row"><label for="qonto_reminder_days" class="col-lg-4"/><field name="qonto_reminder_days"/></div>
                        </div>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
