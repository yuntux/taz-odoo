<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="account_bank_statement_card_view_list" model="ir.ui.view">
        <field name="name">account.bank.statement.card.list</field>
        <field name="model">account.bank.statement.card</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="name"/><field name="code"/><field name="qonto_card_id"/>
                <field name="employee_id"/><field name="journal_id"/><field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>
    <record id="account_bank_statement_card_action" model="ir.actions.act_window">
        <field name="name">Cartes bancaires</field>
        <field name="res_model">account.bank.statement.card</field>
        <field name="view_mode">list</field>
    </record>
    <menuitem id="account_bank_statement_card_menu" name="Cartes bancaires" parent="account.account_account_menu"
              action="account_bank_statement_card_action" sequence="90" groups="account.group_account_manager"/>
</odoo>
